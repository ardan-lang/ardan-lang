// async function asyncouter(a) {
//   print("Before await", a);
// }

// print(asyncouter(800));


async function outer(x) {
  print("Before await", x);
  return 7;
}

async function testAsync() {
  print("Inside inner");
  let v = await outer(10);
  print("After await: ",v);

  let x = await (100);
  print("After await2: ",x);

  print("After await in inner");
}

testAsync();
print("After calling testAsync");

